          <mxGeometry as="geometry" relative="1">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="edge1" value="SVG escapado" style="edgeStyle=none;rounded=0;html=0;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=block;endFill=0;exitX=0.5;exitY=0.0;entryX=0.5;entryY=1.0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="SvgTicketRenderer" target="TicketRenderer">
          <mxGeometry as="geometry" relative="1">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="foot" value="HmacTicketSigner canoniza TicketClaims en JSON y firma con el secreto del evento; compare_digest verifica la firma.&#10;SvgTicketRenderer produce un SVG completo, legible y descargable con código alfanumérico, asiento y hash. No requiere QR.&#10;TicketClaims se detalla en la vista 09. Los algoritmos y formatos técnicos permanecen fuera del núcleo." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="32" y="817" width="1136" height="60" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

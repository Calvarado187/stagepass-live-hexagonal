        <mxCell id="TicketSigner" value="&lt;b&gt;«interface» TicketSigner&lt;/b&gt;&lt;hr&gt;—&lt;hr&gt;+ sign(claims: TicketClaims): str&lt;br&gt;+ verify(claims: TicketClaims, signature: str): bool&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#687080&quot;&gt;core\ports.py&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Helvetica;fontSize=12;fillColor=#E9F0FF;strokeColor=#465269;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="110" width="500" height="190" />
        </mxCell>
        <mxCell id="TicketRenderer" value="&lt;b&gt;«interface» TicketRenderer&lt;/b&gt;&lt;hr&gt;—&lt;hr&gt;+ render(ticket: Ticket, event: Event, seat: Seat): str&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#687080&quot;&gt;core\ports.py&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Helvetica;fontSize=12;fillColor=#E9F0FF;strokeColor=#465269;" vertex="1" parent="1">

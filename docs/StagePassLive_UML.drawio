  <diagram id="page1" name="01 01 / Modelo de dominio">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="heading" value="01 / Modelo de dominio&#10;Entidades puras · nombres coincidentes con el código · atributos inmutables sin ORM" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="32" y="15" width="1136" height="50" />
        </mxCell>
        <mxCell id="Event" value="&lt;b&gt;«class» Event&lt;/b&gt;&lt;hr&gt;+ id: str&lt;br&gt;+ name: str&lt;br&gt;+ kind: str&lt;br&gt;+ venue_id: str&lt;br&gt;+ starts_at: datetime&lt;br&gt;+ state: EventState&lt;hr&gt;(datos inmutables)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#687080&quot;&gt;core\models.py&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Helvetica;fontSize=12;fillColor=#F5EEFF;strokeColor=#465269;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="110" width="330" height="235" />
        </mxCell>
        <mxCell id="Order" value="&lt;b&gt;«class» Order&lt;/b&gt;&lt;hr&gt;+ id: str&lt;br&gt;+ event_id: str&lt;br&gt;+ client: Client&lt;br&gt;+ seats: tuple[Seat, ...]&lt;br&gt;+ quote: Quote&lt;br&gt;+ created_at: datetime&lt;br&gt;+ expires_at: datetime&lt;br&gt;+ provider: str&lt;br&gt;+ state: OrderState&lt;br&gt;+ payment_id: str&lt;br&gt;+ reconciliation: bool&lt;hr&gt;+ holds_at(now: datetime): bool&lt;br&gt;+ expire(now: datetime)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#687080&quot;&gt;core\models.py&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Helvetica;fontSize=12;fillColor=#F5EEFF;strokeColor=#465269;" vertex="1" parent="1">

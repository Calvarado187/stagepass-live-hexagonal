        <mxCell id="edge4" value="1 / 0..6 tickets" style="edgeStyle=none;rounded=0;html=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;exitX=1.0;exitY=0.7857142857142857;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="Order" target="Ticket">

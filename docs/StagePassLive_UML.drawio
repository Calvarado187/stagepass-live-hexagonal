    </mxGraphModel>
  </diagram>
  <diagram id="page9" name="09 09 / Evidencia inmutable y entrega de efectos">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="heading" value="09 / Evidencia inmutable y entrega de efectos&#10;TicketClaims vincula la firma a la compra; Delivery permite reintentar salidas" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="32" y="15" width="1136" height="50" />
        </mxCell>
        <mxCell id="Ticket" value="&lt;b&gt;«entity» Ticket&lt;/b&gt;&lt;hr&gt;+ id: str&lt;br&gt;+ order_id: str&lt;br&gt;+ code: str&lt;br&gt;+ security_hash: str&lt;br&gt;+ issued_at: datetime&lt;br&gt;+ claims: TicketClaims&lt;hr&gt;(datos inmutables)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#687080&quot;&gt;core\models.py&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Helvetica;fontSize=12;fillColor=#F5EEFF;strokeColor=#465269;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="110" width="450" height="265" />
        </mxCell>
        <mxCell id="TicketClaims" value="&lt;b&gt;«value object» TicketClaims&lt;/b&gt;&lt;hr&gt;+ ticket_id: str&lt;br&gt;+ order_id: str&lt;br&gt;+ event_id: str&lt;br&gt;+ client_id: str&lt;br&gt;+ seat_id: str&lt;br&gt;+ base_price: str&lt;br&gt;+ order_total: str&lt;br&gt;+ order_created_at: str&lt;br&gt;+ code: str&lt;hr&gt;(datos inmutables)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#687080&quot;&gt;core\models.py&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Helvetica;fontSize=12;fillColor=#F5EEFF;strokeColor=#465269;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="685" y="110" width="480" height="300" />
        </mxCell>
        <mxCell id="Delivery" value="&lt;b&gt;«value object» Delivery&lt;/b&gt;&lt;hr&gt;+ id: str&lt;br&gt;+ order_id: str&lt;br&gt;+ kind: str&lt;br&gt;+ completed: bool&lt;br&gt;+ attempts: int&lt;hr&gt;(datos inmutables)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#687080&quot;&gt;core\models.py&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Helvetica;fontSize=12;fillColor=#F5EEFF;strokeColor=#465269;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="685" y="535" width="480" height="230" />
        </mxCell>
        <mxCell id="Order" value="&lt;b&gt;«entity» Order&lt;/b&gt;&lt;hr&gt;+ id: str&lt;br&gt;+ event_id: str&lt;br&gt;+ client: Client&lt;br&gt;+ seats: tuple[Seat, ...]&lt;br&gt;+ quote: Quote&lt;br&gt;+ created_at: datetime&lt;br&gt;+ expires_at: datetime&lt;br&gt;+ provider: str&lt;br&gt;+ state: OrderState&lt;br&gt;+ payment_id: str&lt;br&gt;+ reconciliation: bool&lt;hr&gt;+ holds_at(now: datetime): bool&lt;br&gt;+ expire(now: datetime)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#687080&quot;&gt;core\models.py&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Helvetica;fontSize=12;fillColor=#F5EEFF;strokeColor=#465269;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="435" width="450" height="365" />
        </mxCell>
        <mxCell id="edge0" value="1 / 1" style="edgeStyle=none;rounded=0;html=0;fontSize=11;labelBackgroundColor=#ffffff;startArrow=diamond;startFill=1;endArrow=none;exitX=1.0;exitY=0.4716981132075472;entryX=0.0;entryY=0.4166666666666667;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="Ticket" target="TicketClaims">
          <mxGeometry as="geometry" relative="1">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="edge1" value="0..3 / 1" style="edgeStyle=none;rounded=0;html=0;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;exitX=0.0;exitY=0.5;entryX=1.0;entryY=0.589041095890411;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="Delivery" target="Order">
          <mxGeometry as="geometry" relative="1">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="foot" value="Los claims incluyen ticket, orden, evento, cliente, asiento, precio, total, fecha de creación y código de canje.&#10;La firma usa un secreto específico del evento. Delivery.id = order.id + canal: clave idempotente para efectos secundarios.&#10;Los objetos son frozen dataclasses: las transiciones crean versiones nuevas mediante replace(), sin mutación compartida." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="32" y="817" width="1136" height="60" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

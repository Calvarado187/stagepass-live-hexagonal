        <mxCell id="edge1" value="implementa" style="edgeStyle=none;rounded=0;html=0;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=block;endFill=0;exitX=0.5;exitY=0.0;entryX=0.5;entryY=1.0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="SecureIds" target="IdSource">
          <mxGeometry as="geometry" relative="1">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="foot" value="Moneda de esta solución: COP. PaymentReference contiene una referencia y prueba opacas para el dominio, no un HTTPRequest.&#10;SystemClock usa UTC; SecureIds usa 128 bits aleatorios. En pruebas se inyecta ManualClock sin esperar diez minutos reales." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="32" y="817" width="1136" height="60" />
        </mxCell>

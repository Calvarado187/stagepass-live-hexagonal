  <diagram id="page2" name="02 02 / Casos de uso y adaptadores primarios">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="heading" value="02 / Casos de uso y adaptadores primarios&#10;El servicio implementa el contrato de entrada; HTTP y tareas programadas dependen del contrato" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="32" y="15" width="1136" height="50" />
        </mxCell>
        <mxCell id="BookingUseCases" value="&lt;b&gt;«interface» BookingUseCases&lt;/b&gt;&lt;hr&gt;—&lt;hr&gt;+ events(): tuple[Event, ...]&lt;br&gt;+ availability(event_id: str): tuple[Seat, ...]&lt;br&gt;+ quote(event_id: str, seat_ids: tuple[str, ...]): Quote&lt;br&gt;+ reserve(event_id: str, client: Client, seat_ids: tuple[str, ...], provider: str): Order&lt;br&gt;+ confirm(provider: str, reference: PaymentReference): Order&lt;br&gt;+ expire(): int&lt;br&gt;+ get_order(order_id: str): Order&lt;br&gt;+ tickets(order_id: str): tuple[Ticket, ...]&lt;br&gt;+ ticket_svg(order_id: str, ticket_id: str): str&lt;br&gt;+ verify_ticket(order_id: str, ticket_id: str): bool&lt;br&gt;+ dispatch(): int&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#687080&quot;&gt;core\ports.py&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Helvetica;fontSize=12;fillColor=#E9F0FF;strokeColor=#465269;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="120" width="500" height="630" />
        </mxCell>
        <mxCell id="BookingService" value="&lt;b&gt;«class» BookingService&lt;/b&gt;&lt;hr&gt;- catalog: Catalog&lt;br&gt;- store: OrderStore&lt;br&gt;- clock: Clock; ids: IdSource&lt;br&gt;- gateways: dict[str, PaymentGateway]&lt;br&gt;- signer: TicketSigner; renderer: TicketRenderer&lt;br&gt;- notifications: dict[str, Notification]&lt;br&gt;- invoice: Invoice&lt;hr&gt;+ events(): tuple[Event, ...]&lt;br&gt;+ availability(event_id: str): tuple[Seat, ...]&lt;br&gt;+ quote(event_id: str, seat_ids: tuple[str, ...]): Quote&lt;br&gt;+ reserve(event_id: str, client: Client, seat_ids: tuple[str, ...], provider: str): Order&lt;br&gt;+ confirm(provider: str, reference: PaymentReference): Order&lt;br&gt;+ expire(): int&lt;br&gt;+ get_order(order_id: str): Order&lt;br&gt;+ tickets(order_id: str): tuple[Ticket, ...]&lt;br&gt;+ ticket_svg(order_id: str, ticket_id: str): str&lt;br&gt;+ verify_ticket(order_id: str, ticket_id: str): bool&lt;br&gt;+ dispatch(): int&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#687080&quot;&gt;core\service.py&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Helvetica;fontSize=12;fillColor=#F5EEFF;strokeColor=#465269;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="665" y="120" width="500" height="630" />
        </mxCell>
        <mxCell id="edge0" value="implementa" style="edgeStyle=none;rounded=0;html=0;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=block;endFill=0;exitX=0.0;exitY=0.5;entryX=1.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="BookingService" target="BookingUseCases">
          <mxGeometry as="geometry" relative="1">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="foot" value="Las dependencias de BookingService son contratos del núcleo; nunca importa adaptadores.&#10;Línea discontinua con triángulo vacío = realización de interfaz. Se muestran los métodos públicos del contrato.&#10;El ensamblaje de dependencias se realiza en bootstrap.build(). Todos los puertos están en core/ports.py." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="32" y="817" width="1136" height="60" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page3" name="03 03 / Entrada web y tareas temporales">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="heading" value="03 / Entrada web y tareas temporales&#10;Los adaptadores primarios traducen eventos externos a operaciones del núcleo" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="32" y="15" width="1136" height="50" />
        </mxCell>
        <mxCell id="Handler" value="&lt;b&gt;«primary adapter» Handler&lt;/b&gt;&lt;hr&gt;- service: BookingUseCases {injected}&lt;br&gt;- gateways: dict {adapter registry}&lt;hr&gt;+ do_GET(): None&lt;br&gt;+ do_POST(): None&lt;br&gt;+ handle_request(post: bool): None&lt;br&gt;+ reply(data, status, content_type): None&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#687080&quot;&gt;adapters\http.py&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Helvetica;fontSize=12;fillColor=#F5EEFF;strokeColor=#465269;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="130" width="440" height="275" />
        </mxCell>
        <mxCell id="ExpiryScheduler" value="&lt;b&gt;«primary adapter» ExpiryScheduler&lt;/b&gt;&lt;hr&gt;- service: BookingUseCases&lt;br&gt;- stop: threading.Event&lt;br&gt;- thread: Thread&lt;hr&gt;+ start()&lt;br&gt;+ close()&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#687080&quot;&gt;adapters\scheduler.py&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Helvetica;fontSize=12;fillColor=#F5EEFF;strokeColor=#465269;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="480" width="440" height="230" />
        </mxCell>
        <mxCell id="BookingUseCases" value="&lt;b&gt;«interface» BookingUseCases&lt;/b&gt;&lt;hr&gt;—&lt;hr&gt;+ events(): tuple[Event, ...]&lt;br&gt;+ availability(event_id: str): tuple[Seat, ...]&lt;br&gt;+ quote(event_id: str, seat_ids: tuple[str, ...]): Quote&lt;br&gt;+ reserve(event_id: str, client: Client, seat_ids: tuple[str, ...], provider: str): Order&lt;br&gt;+ confirm(provider: str, reference: PaymentReference): Order&lt;br&gt;+ expire(): int&lt;br&gt;+ get_order(order_id: str): Order&lt;br&gt;+ tickets(order_id: str): tuple[Ticket, ...]&lt;br&gt;+ ticket_svg(order_id: str, ticket_id: str): str&lt;br&gt;+ verify_ticket(order_id: str, ticket_id: str): bool&lt;br&gt;+ dispatch(): int&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#687080&quot;&gt;core\ports.py&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Helvetica;fontSize=12;fillColor=#E9F0FF;strokeColor=#465269;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="650" y="150" width="515" height="570" />
        </mxCell>
        <mxCell id="edge0" value="invoca" style="edgeStyle=none;rounded=0;html=0;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;exitX=1.0;exitY=0.4909090909090909;entryX=0.0;entryY=0.2807017543859649;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="Handler" target="BookingUseCases">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="560" y="265" />
              <mxPoint x="560" y="310" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge1" value="expire / dispatch" style="edgeStyle=none;rounded=0;html=0;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.7192982456140351;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="ExpiryScheduler" target="BookingUseCases">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="560" y="595" />
              <mxPoint x="560" y="560" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="foot" value="Handler es una clase interna de make_server(); recibe el servicio por cierre. También expone el endpoint de webhook.&#10;El parser de cada pasarela transforma su notificación técnica a PaymentReference antes de invocar confirm().&#10;Línea discontinua con flecha abierta = dependencia. No hay cálculo de tarifas en los adaptadores primarios." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="32" y="817" width="1136" height="60" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page4" name="04 04 / Catálogo y persistencia">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="heading" value="04 / Catálogo y persistencia&#10;Puertos definidos en el núcleo; implementaciones simuladas reemplazables" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="32" y="15" width="1136" height="50" />
        </mxCell>
        <mxCell id="Catalog" value="&lt;b&gt;«interface» Catalog&lt;/b&gt;&lt;hr&gt;—&lt;hr&gt;+ events(): tuple[Event, ...]&lt;br&gt;+ event(event_id: str): Event&lt;br&gt;+ seats(venue_id: str): tuple[Seat, ...]&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#687080&quot;&gt;core\ports.py&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Helvetica;fontSize=12;fillColor=#E9F0FF;strokeColor=#465269;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="110" width="495" height="220" />
        </mxCell>
        <mxCell id="OrderStore" value="&lt;b&gt;«interface» OrderStore&lt;/b&gt;&lt;hr&gt;—&lt;hr&gt;+ transaction(): ContextManager[None]&lt;br&gt;+ orders(): tuple[Order, ...]&lt;br&gt;+ order(order_id: str): Order&lt;br&gt;+ save_order(order: Order): None&lt;br&gt;+ tickets(order_id: str): tuple[Ticket, ...]&lt;br&gt;+ save_ticket(ticket: Ticket): None&lt;br&gt;+ deliveries(): tuple[Delivery, ...]&lt;br&gt;+ save_delivery(delivery: Delivery): None&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#687080&quot;&gt;core\ports.py&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Helvetica;fontSize=12;fillColor=#E9F0FF;strokeColor=#465269;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="670" y="110" width="495" height="310" />
        </mxCell>
        <mxCell id="MySqlCatalogMock" value="&lt;b&gt;«mock adapter» MySqlCatalogMock&lt;/b&gt;&lt;hr&gt;- data: tuple[Event, ...]&lt;hr&gt;+ events(): tuple[Event, ...]&lt;br&gt;+ event(event_id: str): Event&lt;br&gt;+ seats(venue_id: str): tuple[Seat, ...]&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#687080&quot;&gt;adapters\storage.py&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Helvetica;fontSize=12;fillColor=#FFF2E3;strokeColor=#465269;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="490" width="495" height="230" />
        </mxCell>
        <mxCell id="MongoOrderStoreMock" value="&lt;b&gt;«mock adapter» MongoOrderStoreMock&lt;/b&gt;&lt;hr&gt;- _orders: dict[str, Order]&lt;br&gt;- _tickets: dict[str, Ticket]&lt;br&gt;- _deliveries: dict[str, Delivery]&lt;br&gt;- _lock: RLock&lt;hr&gt;+ transaction(): ContextManager[None]&lt;br&gt;+ orders(): tuple[Order, ...]&lt;br&gt;+ order(order_id: str): Order&lt;br&gt;+ save_order(order: Order): None&lt;br&gt;+ tickets(order_id: str): tuple[Ticket, ...]&lt;br&gt;+ save_ticket(ticket: Ticket): None&lt;br&gt;+ deliveries(): tuple[Delivery, ...]&lt;br&gt;+ save_delivery(delivery: Delivery): None&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#687080&quot;&gt;adapters\storage.py&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Helvetica;fontSize=12;fillColor=#FFF2E3;strokeColor=#465269;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="670" y="490" width="495" height="310" />
        </mxCell>
        <mxCell id="edge0" value="implementa" style="edgeStyle=none;rounded=0;html=0;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=block;endFill=0;exitX=0.5;exitY=0.0;entryX=0.5;entryY=1.0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="MySqlCatalogMock" target="Catalog">
          <mxGeometry as="geometry" relative="1">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="edge1" value="implementa" style="edgeStyle=none;rounded=0;html=0;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=block;endFill=0;exitX=0.5;exitY=0.0;entryX=0.5;entryY=1.0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="MongoOrderStoreMock" target="OrderStore">
          <mxGeometry as="geometry" relative="1">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="foot" value="Destino arquitectónico: MySQL para catálogo legado; MongoDB para órdenes, tickets y bandeja de salida.&#10;Esta entrega usa memoria: NO requiere ni conecta servidores de bases de datos. OrderStore garantiza atomicidad en un proceso.&#10;RLock y snapshots pertenecen al adaptador. El núcleo no conoce conexiones, consultas SQL, documentos BSON ni bloqueos técnicos." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="32" y="817" width="1136" height="60" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page5" name="05 05 / Pagos externos">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">

        </mxCell>
        <mxCell id="Client" value="&lt;b&gt;«class» Client&lt;/b&gt;&lt;hr&gt;+ id: str&lt;br&gt;+ name: str&lt;br&gt;+ email: str&lt;br&gt;+ mobile: str&lt;br&gt;+ nationality: str&lt;hr&gt;+ validate()&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#687080&quot;&gt;core\models.py&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Helvetica;fontSize=12;fillColor=#F5EEFF;strokeColor=#465269;" vertex="1" parent="1">

        </mxCell>
        <mxCell id="HmacTicketSigner" value="&lt;b&gt;«adapter» HmacTicketSigner&lt;/b&gt;&lt;hr&gt;- _secrets: dict[str, bytes]&lt;hr&gt;+ sign(claims: TicketClaims): str&lt;br&gt;+ verify(claims: TicketClaims, signature: str): bool&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#687080&quot;&gt;adapters\tickets.py&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Helvetica;fontSize=12;fillColor=#F5EEFF;strokeColor=#465269;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="400" width="500" height="220" />
        </mxCell>
        <mxCell id="SvgTicketRenderer" value="&lt;b&gt;«adapter» SvgTicketRenderer&lt;/b&gt;&lt;hr&gt;—&lt;hr&gt;+ render(ticket: Ticket, event: Event, seat: Seat): str&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#687080&quot;&gt;adapters\tickets.py&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Helvetica;fontSize=12;fillColor=#F5EEFF;strokeColor=#465269;" vertex="1" parent="1">
